# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` al repositorio.

# Cadena de conexion a PostgreSQL (16+). Ejemplo local:
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/erp_business_demo

# Puerto de la API (el frontend espera 3000 por defecto)
PORT=3000

# Clave para firmar los JWT. Genera una aleatoria larga, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-larga
JWT_EXPIRES_IN=8h

NODE_ENV=development
